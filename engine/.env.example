# Copia este archivo como .env y agrega tus valores privados.
USE_OPENAI_ORCHESTRATOR=1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FAST=
OPENAI_MODEL_SMART=
OPENAI_SMART_FALLBACK=1
OPENAI_FAST_MIN_CONFIDENCE=0.80
OPENAI_SMART_MIN_CONFIDENCE=0.65
OPENAI_ESCALATE_ON_AMBIGUOUS=1
OPENAI_ESCALATE_ON_CONTEXT_REFERENCES=1
OPENAI_ESCALATE_ON_MINI_CLARIFICATION=1
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_CONTEXT_FILES=20
OPENAI_MAX_CONTEXT_FOLDERS=20
OPENAI_MONTHLY_SOFT_LIMIT_USD=0
OPENAI_MAX_MONTHLY_USD=0
OPENAI_LOG_USAGE=1
OPENAI_ORCHESTRATOR_ONLY_FALLBACK=1
USE_SEMANTIC_ROUTER=1
SEMANTIC_MODEL=
SEMANTIC_THRESHOLD_DEFAULT=0.72

# Ruta opcional al JSON OAuth de Google fuera del repositorio.
FACESYNC_GOOGLE_CLIENT_SECRET=


{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceSync",
  "version": "1.0.0",
  "identifier": "com.ianca.facesyncv2",
  "build": {
    "beforeDevCommand": "node start-dev.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FaceSync",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ian Carlo Sanchez Tellez",
    "copyright": "© 2026 FaceSync. Todos los derechos reservados.",
    "category": "Productivity",
    "shortDescription": "Clasificación de fotos por reconocimiento facial",
    "longDescription": "FaceSync clasifica automáticamente fotos JPG, CR2 y CR3 por persona usando reconocimiento facial.",
    "resources": ["resources/engine/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
